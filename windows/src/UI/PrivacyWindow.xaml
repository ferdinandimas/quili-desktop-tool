<Window x:Class="Quili.UI.PrivacyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quili – Privacy &amp; apps" Icon="/assets/app.ico" Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="15" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Palette -->
        <SolidColorBrush x:Key="Green" Color="#3DBE4A" />
        <SolidColorBrush x:Key="GreenDeep" Color="#27AE4B" />
        <SolidColorBrush x:Key="GreenInk" Color="#1B7F3A" />
        <SolidColorBrush x:Key="GreenTint" Color="#E4F4E9" />
        <SolidColorBrush x:Key="Ink" Color="#0F1F16" />
        <SolidColorBrush x:Key="Muted" Color="#6E7B73" />
        <SolidColorBrush x:Key="Line" Color="#D3DAD6" />
        <SolidColorBrush x:Key="RobotInk" Color="#1F2A24" />

        <!-- Icons (24x24 glyphs) -->
        <Geometry x:Key="CloseGeometry">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12z</Geometry>
        <Geometry x:Key="SaveGeometry">M17,3H5C3.89,3,3,3.9,3,5v14c0,1.1,0.89,2,2,2h14c1.1,0,2-0.9,2-2V7L17,3z M12,19c-1.66,0-3-1.34-3-3s1.34-3,3-3s3,1.34,3,3S13.66,19,12,19z M15,9H5V5h10V9z</Geometry>
        <Geometry x:Key="EyeOffGeometry">M12,7c2.76,0,5,2.24,5,5c0,0.65-0.13,1.26-0.36,1.83l2.92,2.92c1.51-1.26,2.7-2.89,3.43-4.75c-1.73-4.39-6-7.5-11-7.5c-1.4,0-2.74,0.25-3.98,0.7l2.16,2.16C10.74,7.13,11.35,7,12,7z M2,4.27l2.28,2.28l0.46,0.46C3.08,8.3,1.78,10.02,1,12c1.73,4.39,6,7.5,11,7.5c1.55,0,3.03-0.3,4.38-0.84l0.42,0.42L19.73,22L21,20.73L3.27,3L2,4.27z M7.53,9.8l1.55,1.55C9.03,11.56,9,11.78,9,12c0,1.66,1.34,3,3,3c0.22,0,0.44-0.03,0.65-0.08l1.55,1.55c-0.67,0.33-1.41,0.53-2.2,0.53c-2.76,0-5-2.24-5-5C7,11.21,7.2,10.47,7.53,9.8z M11.84,9.02l3.15,3.15l0.02-0.16c0-1.66-1.34-3-3-3L11.84,9.02z</Geometry>
        <Geometry x:Key="CheckGeometry">M9,16.17L4.83,12l-1.42,1.41L9,19L21,7l-1.41-1.41z</Geometry>
        <Geometry x:Key="AppsGeometry">M4,8h4V4H4V8z M10,20h4v-4h-4V20z M4,20h4v-4H4V20z M4,14h4v-4H4V14z M10,14h4v-4h-4V14z M16,4v4h4V4H16z M10,8h4V4h-4V8z M16,14h4v-4h-4V14z M16,20h4v-4h-4V20z</Geometry>

        <!-- The robot face from the overlay button -->
        <DataTemplate x:Key="RobotIcon">
            <Viewbox>
                <Canvas Width="24" Height="24">
                    <Line X1="12" Y1="3.5" X2="12" Y2="7" Stroke="{StaticResource RobotInk}" StrokeThickness="1.6" StrokeStartLineCap="Round" />
                    <Ellipse Canvas.Left="10.4" Canvas.Top="1.6" Width="3.2" Height="3.2" Fill="{StaticResource RobotInk}" />
                    <Rectangle Canvas.Left="2" Canvas.Top="11" Width="3" Height="5" RadiusX="1.2" RadiusY="1.2" Fill="{StaticResource RobotInk}" />
                    <Rectangle Canvas.Left="19" Canvas.Top="11" Width="3" Height="5" RadiusX="1.2" RadiusY="1.2" Fill="{StaticResource RobotInk}" />
                    <Rectangle Canvas.Left="4.5" Canvas.Top="7" Width="15" Height="13" RadiusX="3.5" RadiusY="3.5" Fill="{StaticResource RobotInk}" />
                    <Ellipse Canvas.Left="8" Canvas.Top="10.8" Width="3.2" Height="3.2" Fill="{StaticResource Green}" />
                    <Ellipse Canvas.Left="12.8" Canvas.Top="10.8" Width="3.2" Height="3.2" Fill="{StaticResource Green}" />
                    <Line X1="9.5" Y1="16.8" X2="14.5" Y2="16.8" Stroke="{StaticResource Green}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Round tinted badge in front of each section title -->
        <Style x:Key="IconBadge" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Background" Value="{StaticResource GreenTint}" />
        </Style>
        <Style x:Key="BadgeGlyph" TargetType="Path">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{StaticResource GreenInk}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Rounded input frame; the TextBox / PasswordBox inside is drawn bare -->
        <Style x:Key="FieldFrame" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="18,0" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Green}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BareBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource GreenDeep}" CornerRadius="24">
                            <Border.Effect>
                                <DropShadowEffect Color="#27AE4B" Opacity="0.35" BlurRadius="14" ShadowDepth="4" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F9E43" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#198A3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1.5" CornerRadius="24">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E6ECE8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="26" Height="26" CornerRadius="8" Background="White"
                                    BorderBrush="#B5C0B9" BorderThickness="1.5">
                                <Path x:Name="Tick" Data="{StaticResource CheckGeometry}" Fill="White" Stretch="Uniform"
                                      Width="16" Height="16" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource GreenDeep}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GreenDeep}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GreenDeep}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The card; the margin leaves room for its soft shadow inside the transparent window -->
    <Border Margin="30" CornerRadius="26" Background="White" BorderBrush="{StaticResource Green}" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect Color="#1B7F3A" Opacity="0.20" BlurRadius="32" ShadowDepth="8" Direction="270" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="24,24,0,0" Padding="28,20,18,20" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E7F5EC" Offset="0" />
                        <GradientStop Color="#F3FAF6" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="50" Height="50" CornerRadius="25" Background="{StaticResource Green}">
                        <ContentControl Content="robot" ContentTemplate="{StaticResource RobotIcon}" Width="28" Height="28" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Quili" FontSize="23" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                        <TextBlock Text="Privacy &amp; apps" FontSize="15" Foreground="{StaticResource Muted}" />
                    </StackPanel>

                    <Button Grid.Column="2" Width="34" Height="34" VerticalAlignment="Top" Style="{StaticResource IconButton}"
                            ToolTip="Close" Click="Close_Click">
                        <Path Data="{StaticResource CloseGeometry}" Fill="#44514A" Stretch="Uniform" Width="14" Height="14" />
                    </Button>
                </Grid>
            </Border>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="28,24,28,22">

                <!-- Before sending -->
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBadge}"><Path Style="{StaticResource BadgeGlyph}" Data="{StaticResource EyeOffGeometry}" /></Border>
                    <TextBlock Grid.Column="2" Text="Before sending" Style="{StaticResource SectionTitle}" />
                </Grid>

                <CheckBox x:Name="RedactBox" Content="Redact secrets before sending" Style="{StaticResource GreenCheck}" Margin="2,14,0,0" />
                <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="13.5" Margin="42,4,0,0"
                           Text="Keys, tokens and passwords are swapped for placeholders before the text leaves your computer, and put back in the answer." />

                <CheckBox x:Name="EmailBox" Content="Also redact email addresses" Style="{StaticResource GreenCheck}" Margin="2,16,0,0" />

                <CheckBox x:Name="WarnBox" Content="Warn me when my text contains a secret" Style="{StaticResource GreenCheck}" Margin="2,16,0,0" />
                <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="13.5" Margin="42,4,0,0"
                           Text="A small ! shows on the Quili button. The check runs on this computer; nothing is sent." />

                <CheckBox x:Name="ContextBox" Content="Use the messages above as context in Slack" Style="{StaticResource GreenCheck}" Margin="2,16,0,0" />
                <TextBlock x:Name="ContextHint" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="13.5" Margin="42,4,0,0" />

                <!-- On this computer -->
                <Grid Margin="0,26,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBadge}"><Path Style="{StaticResource BadgeGlyph}" Data="{StaticResource SaveGeometry}" /></Border>
                    <TextBlock Grid.Column="2" Text="On this computer" Style="{StaticResource SectionTitle}" />
                </Grid>

                <CheckBox x:Name="HistoryBox" Content="Keep my last 10 rewrites on this computer" Style="{StaticResource GreenCheck}" Margin="2,14,0,0" />
                <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="13.5" Margin="42,4,0,0"
                           Text="Saved only on this computer. Turning this off and saving also clears the list." />

                <CheckBox x:Name="UpdateBox" Content="Check for updates once a day" Style="{StaticResource GreenCheck}" Margin="2,16,0,0" />
                <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="13.5" Margin="42,4,0,0"
                           Text="Asks GitHub for the latest release. Nothing else is sent." />

                <!-- Apps -->
                <Grid Margin="0,26,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBadge}"><Path Style="{StaticResource BadgeGlyph}" Data="{StaticResource AppsGeometry}" /></Border>
                    <TextBlock Grid.Column="2" Text="Apps" Style="{StaticResource SectionTitle}" />
                </Grid>

                <CheckBox x:Name="OnlyBox" Content="Only show Quili in the apps listed below" Style="{StaticResource GreenCheck}" Margin="2,14,0,0" />
                <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="13.5" Margin="0,4,0,0"
                           Text="One per line, using the process name (for example: slack, chrome, notepad). Quili's ✦ button is hidden in these apps — or shown only in them when the box above is ticked. The Summarize button for Slack threads is not affected." />
                <Border Style="{StaticResource FieldFrame}" CornerRadius="22" Padding="18,12,10,12" Margin="0,12,0,0">
                    <TextBox x:Name="AppsBox" Style="{StaticResource BareBox}" Height="110" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                </Border>

                <Border Height="1" Background="#E6ECE8" Margin="0,22,0,18" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PrimaryButton}" Width="150" Height="46" IsDefault="True" Margin="0,0,12,0" Click="Save_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource SaveGeometry}" Fill="White" Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Save" Margin="12,0,0,0" FontSize="16" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="108" Height="46" IsCancel="True" FontSize="16" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
