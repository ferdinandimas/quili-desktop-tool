<Window x:Class="Quili.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quili – Settings" Icon="/assets/app.ico" Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="15" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Palette -->
        <SolidColorBrush x:Key="Green" Color="#3DBE4A" />
        <SolidColorBrush x:Key="GreenDeep" Color="#27AE4B" />
        <SolidColorBrush x:Key="GreenInk" Color="#1B7F3A" />
        <SolidColorBrush x:Key="GreenTint" Color="#E4F4E9" />
        <SolidColorBrush x:Key="Ink" Color="#0F1F16" />
        <SolidColorBrush x:Key="Muted" Color="#6E7B73" />
        <SolidColorBrush x:Key="Line" Color="#D3DAD6" />
        <SolidColorBrush x:Key="RobotInk" Color="#1F2A24" />

