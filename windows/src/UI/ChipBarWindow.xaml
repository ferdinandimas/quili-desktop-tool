<Window x:Class="Quili.UI.ChipBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" Width="40" Height="40">
    <!-- A row of small text chips next to the pill (tone presets, or Undo / Original). Never takes focus, so the
         field being edited keeps the keyboard. -->
    <Border x:Name="Card" Background="White" BorderBrush="#26000000" BorderThickness="1" CornerRadius="10"
            Padding="5" HorizontalAlignment="Left" VerticalAlignment="Top"
            MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
        <StackPanel x:Name="Row" Orientation="Horizontal" />
    </Border>
</Window>
