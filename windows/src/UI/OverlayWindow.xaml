<Window x:Class="Quili.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" Width="28" Height="28">
    <!-- Collapsed: just the green round button on the right. Hovered: a white pill grows to the left
         with the action buttons (Translate to English, Paraphrase) in front of the round button. -->
    <Grid x:Name="Root" Background="Transparent" MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave"
          PreviewMouseLeftButtonDown="Root_PreviewMouseDown" PreviewMouseMove="Root_PreviewMouseMove"
          PreviewMouseLeftButtonUp="Root_PreviewMouseUp">
        <!-- The window stays full width at all times and only this host grows, so the round button never
             moves while the pill opens (resizing the native window every frame made it shake). -->
        <Grid x:Name="PillHost" HorizontalAlignment="Right" Width="28" ClipToBounds="True">
        <Border x:Name="Pill" Background="White" BorderBrush="#26000000" BorderThickness="1"
                CornerRadius="14" Opacity="0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0">
            <Border x:Name="SettingsAction" Width="36" Height="26" Opacity="0" Background="Transparent"
                    Cursor="Hand" ToolTip="Settings" MouseLeftButtonUp="Settings_MouseLeftButtonUp">
                <Viewbox Width="17" Height="17">
                    <Canvas Width="24" Height="24">
                        <Path Fill="#3DBE4A"
                              Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" />
                    </Canvas>
                </Viewbox>
            </Border>

            <Border x:Name="TranslateAction" Width="36" Height="26" Opacity="0" Background="Transparent"
                    Cursor="Hand" ToolTip="Translate to English" MouseLeftButtonUp="Translate_MouseLeftButtonUp">
                <TextBlock Text="EN" Foreground="#3DBE4A" FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Border x:Name="ParaphraseAction" Width="36" Height="26" Opacity="0" Background="Transparent"
                    Cursor="Hand" ToolTip="Paraphrase" MouseLeftButtonUp="Action_MouseLeftButtonUp">
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Path Fill="#3DBE4A"
                              Data="M9,5 C9.7,9.4 10.6,11.3 15,13 C10.6,14.7 9.7,16.6 9,21 C8.3,16.6 7.4,14.7 3,13 C7.4,11.3 8.3,9.4 9,5 Z" />
                        <Path Fill="#3DBE4A"
                              Data="M18,2 C18.3,4.2 18.8,4.7 21,5 C18.8,5.3 18.3,5.8 18,8 C17.7,5.8 17.2,5.3 15,5 C17.2,4.7 17.7,4.2 18,2 Z" />
                    </Canvas>
                </Viewbox>
            </Border>

        </StackPanel>
        </Grid>

            <Border x:Name="Chip" HorizontalAlignment="Right" VerticalAlignment="Center" Width="26" Height="26" Margin="1" CornerRadius="13" Background="#3DBE4A"
                    Cursor="Hand" ToolTip="Text Tool" MouseLeftButtonUp="Chip_MouseLeftButtonUp">
                <Grid>
                    <Viewbox x:Name="Robot" Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Line X1="12" Y1="3.5" X2="12" Y2="7" Stroke="#1F2A24" StrokeThickness="1.6" StrokeStartLineCap="Round" />
                            <Ellipse Canvas.Left="10.4" Canvas.Top="1.6" Width="3.2" Height="3.2" Fill="#1F2A24" />
                            <Rectangle Canvas.Left="2" Canvas.Top="11" Width="3" Height="5" RadiusX="1.2" RadiusY="1.2" Fill="#1F2A24" />
                            <Rectangle Canvas.Left="19" Canvas.Top="11" Width="3" Height="5" RadiusX="1.2" RadiusY="1.2" Fill="#1F2A24" />
                            <Rectangle Canvas.Left="4.5" Canvas.Top="7" Width="15" Height="13" RadiusX="3.5" RadiusY="3.5" Fill="#1F2A24" />
                            <Ellipse Canvas.Left="8" Canvas.Top="10.8" Width="3.2" Height="3.2" Fill="#3DBE4A" />
                            <Ellipse Canvas.Left="12.8" Canvas.Top="10.8" Width="3.2" Height="3.2" Fill="#3DBE4A" />
                            <Line X1="9.5" Y1="16.8" X2="14.5" Y2="16.8" Stroke="#3DBE4A" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                    <!-- Busy spinner: a quarter arc spun by OverlayWindow.SetBusy. -->
                    <Grid x:Name="Spinner" Width="14" Height="14" Visibility="Collapsed"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Stroke="#331F2A24" StrokeThickness="2" />
                        <Ellipse Stroke="#1F2A24" StrokeThickness="2" StrokeDashArray="5.5 16.5" StrokeDashCap="Round"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="Spin" Angle="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <!-- Cancel mark: shown instead of the spinner while hovering the busy button. -->
                    <Canvas x:Name="CancelMark" Width="12" Height="12" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Line X1="1.5" Y1="1.5" X2="10.5" Y2="10.5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="10.5" Y1="1.5" X2="1.5" Y2="10.5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Grid>
            </Border>
    </Grid>
</Window>
