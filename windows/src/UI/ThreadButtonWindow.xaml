<Window x:Class="Quili.UI.ThreadButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" Width="40" Height="40">
    <!-- The round green sparkle button that sits just left of Slack's own "Summarize thread" button; "Summarize thread on Quili" is
         its tooltip. Never takes focus from Slack. -->
    <Border x:Name="Pill" Background="#27AE4B" CornerRadius="14" Width="28" Height="28"
            HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Hand" ToolTip="Summarize thread on Quili"
            MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave" MouseLeftButtonUp="Pill_MouseLeftButtonUp">
        <Viewbox Width="16" Height="16">
            <Canvas Width="24" Height="24">
                <Path Fill="White"
                      Data="M9,5 C9.7,9.4 10.6,11.3 15,13 C10.6,14.7 9.7,16.6 9,21 C8.3,16.6 7.4,14.7 3,13 C7.4,11.3 8.3,9.4 9,5 Z" />
                <Path Fill="White"
                      Data="M18,2 C18.3,4.2 18.8,4.7 21,5 C18.8,5.3 18.3,5.8 18,8 C17.7,5.8 17.2,5.3 15,5 C17.2,4.7 17.7,4.2 18,2 Z" />
            </Canvas>
        </Viewbox>
    </Border>
</Window>
